// Fixed-purpose client; no shell, subprocesses, configurable paths or credentials.
// Installed root-owned, but sudo may run it ONLY as the existing UID @@SERVICE_UID@@ service.
#import <Foundation/Foundation.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <sys/stat.h>
#include <sys/time.h>
#include <unistd.h>
#include <signal.h>
#include <errno.h>
#include <string.h>

static int fail(const char *reason, int code) { fprintf(stderr, "%s\n", reason); return code; }

int main(int argc, const char *argv[]) {
  @autoreleasepool {
    if (argc != 2 || (strcmp(argv[1], "status") && strcmp(argv[1], "arm") && strcmp(argv[1], "lock")))
      return fail("TOKYO_CONTROL_ARGUMENTS", 64);
    if (getuid() != @@SERVICE_UID@@ || geteuid() != @@SERVICE_UID@@)
      return fail("TOKYO_CONTROL_SERVICE_IDENTITY_REQUIRED", 77);
    umask(0077);
    if (chdir("/") != 0) return fail("TOKYO_CONTROL_CWD", 77);
    signal(SIGPIPE, SIG_IGN);
    // A hard deadline also covers partial responses and unexpected peer behavior.
    alarm(50);
    const char *socketPath = "@@SYSTEM_ROOT@@/private/control.sock";
    struct stat st;
    if (lstat(socketPath, &st) || !S_ISSOCK(st.st_mode) || st.st_uid != @@SERVICE_UID@@ || (st.st_mode & 0077))
      return fail("TOKYO_CONTROL_SOCKET_UNSAFE_OR_UNAVAILABLE", 69);
    int fd = socket(AF_UNIX, SOCK_STREAM, 0);
    if (fd < 0) return fail("TOKYO_CONTROL_SOCKET_FAILED", 69);
    struct timeval timeout = { 45, 0 };
    if (setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) ||
        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout))) {
      close(fd); return fail("TOKYO_CONTROL_TIMEOUT_SETUP_FAILED", 69);
    }
    struct sockaddr_un address = {0}; address.sun_family = AF_UNIX;
    strlcpy(address.sun_path, socketPath, sizeof(address.sun_path));
    if (connect(fd, (struct sockaddr *)&address, sizeof(address))) {
      close(fd); return fail("TOKYO_CONTROL_CONNECT_FAILED", 69);
    }
    uid_t peerUid; gid_t peerGid;
    if (getpeereid(fd, &peerUid, &peerGid) || peerUid != @@SERVICE_UID@@) {
      close(fd); return fail("TOKYO_CONTROL_PEER_REJECTED", 77);
    }
    char request[64]; int requestLength = snprintf(request, sizeof(request), "{\"command\":\"%s\"}\n", argv[1]);
    size_t sent = 0;
    while (sent < (size_t)requestLength) {
      ssize_t n = write(fd, request + sent, (size_t)requestLength - sent);
      if (n < 0 && errno == EINTR) continue;
      if (n <= 0) { close(fd); return fail("TOKYO_CONTROL_SEND_FAILED", 69); }
      sent += (size_t)n;
    }
    NSMutableData *data = [NSMutableData data]; char buffer[4096];
    while (true) {
      ssize_t n = read(fd, buffer, sizeof(buffer));
      if (n < 0 && errno == EINTR) continue;
      if (n < 0) { close(fd); return fail("TOKYO_CONTROL_READ_FAILED", 69); }
      if (n == 0) break;
      if (data.length + (NSUInteger)n > 32768) { close(fd); return fail("TOKYO_CONTROL_RESPONSE_TOO_LARGE", 69); }
      [data appendBytes:buffer length:(NSUInteger)n];
    }
    close(fd); alarm(0);
    id result = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
    if (![result isKindOfClass:[NSDictionary class]] || ![result[@"uid"] isEqual:@@@SERVICE_UID@@] ||
        ![result[@"latch"] isKindOfClass:[NSDictionary class]])
      return fail("TOKYO_CONTROL_RESPONSE_INVALID", 69);
    NSData *output = [NSJSONSerialization dataWithJSONObject:result options:NSJSONWritingPrettyPrinted error:nil];
    if (!output) return fail("TOKYO_CONTROL_RESPONSE_INVALID", 69);
    fwrite(output.bytes, 1, output.length, stdout); fputc('\n', stdout);
    if (![result[@"ok"] isEqual:@YES]) return 1;
    if (!strcmp(argv[1], "arm") && ![result[@"latch"][@"state"] isEqual:@"READY"]) return 1;
    if (!strcmp(argv[1], "lock") && ![result[@"latch"][@"state"] isEqual:@"LOCKED"]) return 1;
    return 0;
  }
}
