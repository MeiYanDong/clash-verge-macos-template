{
  "name": "clash-verge-macos-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parameterized Clash/Mihomo routing and a macOS Tokyo residential gateway",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
